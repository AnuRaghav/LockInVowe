# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM Provider (choose one)
ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key
# GOOGLE_API_KEY=your-google-api-key

# Source Layer providers.
# Connections and credentials live in `source_connections`; these are only the
# app-level settings each provider integration needs.

# Plaid
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox

# Rho. Tokens are per-connection and pasted in at link time via
# POST /api/source/connections, not set here. This is only the default
# environment new connections are created against: sandbox | production.
RHO_ENV=sandbox
# Opt-in test gates. `npm run test:integration` sets both for you against a
# local `npm run db:start` stack; set them by hand only to run the tests
# piecemeal.
#   RHO_LIVE_SMOKE=1       lib/source/rho/live.test.ts (hits Rho's sandbox)
#   SUPABASE_INTEGRATION=1 lib/source/store.integration.test.ts (needs local DB)

# Gusto (payroll data connector, OAuth2). Not part of the Source Layer -
# payroll has no "account"/"entry" shape, so it keeps its own tables
# (see supabase/migrations/20260913075634_gusto_connector.sql).
GUSTO_CLIENT_ID=your-gusto-client-id
GUSTO_CLIENT_SECRET=your-gusto-client-secret
GUSTO_REDIRECT_URI=http://localhost:3000/api/gusto/callback
GUSTO_ENV=sandbox

# TEMPORARY: company scoping until auth exists.
# Every request runs as this company. See lib/company/context.ts.
# DEV_COMPANY_ID=00000000-0000-4000-8000-000000000001

# Sam agent (optional overrides)
# SAM_MODEL=claude-sonnet-4-5
# SAM_MAX_TOKENS=4096
# SAM_EFFORT=medium

# Sam execution policy - how much one run may cost.
# Defaults live in lib/agents/sam/harness/policy.ts.
# SAM_MAX_MODEL_CALLS=8
# SAM_MAX_TOOL_CALLS=12
# SAM_RUN_DEADLINE_MS=60000
# SAM_MODEL_TIMEOUT_MS=30000
# SAM_TOOL_TIMEOUT_MS=15000
# Set to "false" to silence the per-run structured log line.
# SAM_LOG_RUNS=true

# ElevenLabs voice (optional - Sam runs text-only without these)
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_VOICE_ID=your-voice-id
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
