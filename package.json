{
  "name": "lockivowe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "eval \"$(supabase status -o env)\" && SUPABASE_INTEGRATION=1 RHO_LIVE_SMOKE=1 NEXT_PUBLIC_SUPABASE_URL=\"$API_URL\" NEXT_PUBLIC_SUPABASE_ANON_KEY=\"$ANON_KEY\" SUPABASE_SERVICE_ROLE_KEY=\"$SERVICE_ROLE_KEY\" vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:migration": "supabase migration new",
    "db:migrate": "supabase migration up --local",
    "db:reset": "supabase db reset --local",
    "db:types": "supabase gen types typescript --local --schema public > lib/supabase/types.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^0.0.50",
    "@elevenlabs/elevenlabs-js": "^2.68.0",
    "@langchain/anthropic": "^1.5.10",
    "@langchain/core": "^1.2.11",
    "@supabase/ssr": "^0.5",
    "@supabase/supabase-js": "^2.45",
    "ai": "^4.1",
    "langchain": "^1.5.11",
    "next": "16.3.5",
    "plaid": "^47.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-plaid-link": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "supabase": "2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
